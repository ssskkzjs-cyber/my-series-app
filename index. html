// ضع رابط ملف JSON الخارجي هنا لاحقاً
const DATA_URL = "";

const container = document.getElementById("episodes");

// عرض المسلسلات
function displayEpisodes(data) {

    container.innerHTML = "";

    data.forEach(item => {

        const a = document.createElement("a");
        a.href = item.link;

        const img = document.createElement("img");
        img.src = item.image;
        img.alt = item.title;
        img.loading = "lazy";

        const title = document.createElement("div");
        title.className = "episode-title";
        title.textContent = item.title;

        a.appendChild(img);
        a.appendChild(title);

        container.appendChild(a);

    });
}

// العرض الأول
displayEpisodes(initialData);

// تحديث البيانات من الإنترنت
async function updateEpisodes() {

    if (!DATA_URL) return;

    try {

        const response = await fetch(
            DATA_URL + "?t=" + Date.now(),
            { cache: "no-store" }
        );

        if (!response.ok) return;

        const newData = await response.json();

        if (Array.isArray(newData)) {
            displayEpisodes(newData);
        }

    } catch (error) {
        console.log("تعذر تحديث البيانات");
    }

}

// فحص لتحديث كل 10 ثوانٍ
setInterval(updateEpisodes, 10000);

</script>

</body>
</html>
