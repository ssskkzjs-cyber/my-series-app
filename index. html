<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body {
    margin: 0;
    padding: 10px;
    background: transparent;
    font-family: Arial, sans-serif;
}

.episodes-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.episodes-container a {
    text-decoration: none;
    color: white;
    text-align: center;
    overflow: hidden;
}

.episodes-container img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 8px;
    display: block;
}

.episode-title {
    font-size: 13px;
    font-weight: bold;
    padding: 8px 2px;
    color: white;
}
</style>
</head>

<body>

<div class="episodes-container" id="episodes">
</div>

<script>

